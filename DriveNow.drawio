        <mxCell id="pcd_2_c5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3a2e5f;strokeColor=#0f2c47;fontColor=#ffffff;fontSize=12;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;SRS Section&lt;/b&gt;" vertex="1">
          <mxGeometry height="38" width="190" x="115" y="119" as="geometry" />
        </mxCell>
        <mxCell id="pcd_2_c6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3a2e5f;strokeColor=#0f2c47;fontColor=#ffffff;fontSize=12;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;Business Rule&lt;/b&gt;" vertex="1">
          <mxGeometry height="38" width="310" x="305" y="119" as="geometry" />
        </mxCell>
        <mxCell id="pcd_2_c7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3a2e5f;strokeColor=#0f2c47;fontColor=#ffffff;fontSize=12;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;Why Constraints Are Not Enough&lt;/b&gt;" vertex="1">
          <mxGeometry height="38" width="360" x="615" y="119" as="geometry" />
        </mxCell>
        <mxCell id="pcd_2_c8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3a2e5f;strokeColor=#0f2c47;fontColor=#ffffff;fontSize=12;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;How to Enforce It&lt;/b&gt;" vertex="1">
          <mxGeometry height="38" width="345" x="975" y="119" as="geometry" />
        </mxCell>
        <mxCell id="pcd_2_c9" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=center;spacingLeft=0;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;BR1&lt;/b&gt;" vertex="1">
          <mxGeometry height="106" width="55" x="60" y="157" as="geometry" />
        </mxCell>
        <mxCell id="pcd_2_c10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;7.1 Branches &amp;amp; Staff&lt;/b&gt;" vertex="1">
          <mxGeometry height="106" width="190" x="115" y="157" as="geometry" />
        </mxCell>
        <mxCell id="pcd_2_c11" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&amp;quot;A person cannot be both an agent and a mechanic.&amp;quot;" vertex="1">
          <mxGeometry height="106" width="310" x="305" y="157" as="geometry" />
        </mxCell>
        <mxCell id="pcd_2_c12" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="RENTAL_AGENT and MECHANIC are two separate tables referencing EMPLOYEE(EmployeeID). A CHECK constraint can only inspect columns within the same row of a single table; it cannot query another table to check if EmployeeID already exists there." vertex="1">
          <mxGeometry height="106" width="360" x="615" y="157" as="geometry" />
        </mxCell>
        <mxCell id="pcd_2_c13" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="Database Trigger (BEFORE INSERT on RENTAL_AGENT and MECHANIC that checks the other table and raises an error if the EmployeeID exists) or Stored Procedure used for assigning roles." vertex="1">
          <mxGeometry height="106" width="345" x="975" y="157" as="geometry" />
        </mxCell>
        <mxCell id="pcd_2_c14" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f4f9;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=center;spacingLeft=0;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;BR2&lt;/b&gt;" vertex="1">
          <mxGeometry height="106" width="55" x="60" y="263" as="geometry" />
        </mxCell>
        <mxCell id="pcd_2_c15" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f4f9;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;7.3 &amp;amp; 7.12 / 7.6&lt;/b&gt;" vertex="1">
          <mxGeometry height="106" width="190" x="115" y="263" as="geometry" />
        </mxCell>
        <mxCell id="pcd_2_c16" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f4f9;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="A vehicle&amp;#x27;s CurrentOdometer must never decrease across sequential rentals or transfers, and a transfer&amp;#x27;s FromBranch must match the vehicle&amp;#x27;s current physical branch." vertex="1">
          <mxGeometry height="106" width="310" x="305" y="263" as="geometry" />
        </mxCell>
        <mxCell id="pcd_2_c17" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f4f9;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="Standard CHECK constraints can compare EndOdometer &amp;gt;= StartOdometer within a single RENTAL row, but cannot compare a new rental&amp;#x27;s StartOdometer or a transfer&amp;#x27;s OdometerReading against the VEHICLE table&amp;#x27;s CurrentOdometer or previous rows." vertex="1">
          <mxGeometry height="106" width="360" x="615" y="263" as="geometry" />
        </mxCell>
        <mxCell id="pcd_2_c18" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f4f9;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="Database Trigger or Transactional Stored Procedure when inserting into RENTAL / VEHICLE_TRANSFER that validates against VEHICLE.CurrentOdometer and updates VEHICLE." vertex="1">
          <mxGeometry height="106" width="345" x="975" y="263" as="geometry" />
        </mxCell>
        <mxCell id="pcd_2_c19" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=center;spacingLeft=0;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;BR3&lt;/b&gt;" vertex="1">
          <mxGeometry height="124" width="55" x="60" y="369" as="geometry" />
        </mxCell>
        <mxCell id="pcd_2_c20" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;7.7 Customers &amp;amp; 7.11 Reservations&lt;/b&gt;" vertex="1">
          <mxGeometry height="124" width="190" x="115" y="369" as="geometry" />
        </mxCell>
        <mxCell id="pcd_2_c21" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&amp;quot;A blacklisted customer cannot book again&amp;quot; (and only a branch manager can blacklist a customer)." vertex="1">
          <mxGeometry height="124" width="310" x="305" y="369" as="geometry" />
        </mxCell>
        <mxCell id="pcd_2_c22" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="When a row is inserted into RESERVATION or RENTAL, a CHECK constraint on RESERVATION cannot query the CUSTOMER table to see if BlacklistedByEmpID IS NOT NULL, nor can a CHECK on CUSTOMER verify that BlacklistedByEmpID currently holds a row in BRANCH.ManagerID." vertex="1">
          <mxGeometry height="124" width="360" x="615" y="369" as="geometry" />
        </mxCell>
        <mxCell id="pcd_2_c23" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="Database Trigger (BEFORE INSERT on RESERVATION and RENTAL checking CUSTOMER blacklist status, and BEFORE UPDATE on CUSTOMER verifying the employee is a current Branch Manager)." vertex="1">
          <mxGeometry height="124" width="345" x="975" y="369" as="geometry" />
        </mxCell>
