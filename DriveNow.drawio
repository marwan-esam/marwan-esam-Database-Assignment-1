        <mxCell id="pcd_2_c2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;align=left;spacingLeft=15;" value="&lt;b&gt;Name: Marwan Mohamed Esam &amp;nbsp;|&amp;nbsp; Group: 2&lt;/b&gt;" vertex="1">
          <mxGeometry height="40" width="480" x="60" y="20" as="geometry" />
