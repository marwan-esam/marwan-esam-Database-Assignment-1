        <mxCell id="pcd_2_c3" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontColor=#1a1a1a;" value="&lt;b&gt;Part D — Business Rules&lt;/b&gt;" vertex="1">
