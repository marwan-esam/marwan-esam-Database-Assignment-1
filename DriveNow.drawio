        <mxCell id="pcd_2_c26" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f4f9;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&amp;quot;DriveNow has two kinds of customers, and every customer is one or the other.&amp;quot; (Disjoint &amp;amp; complete subtypes across INDIVIDUAL_CUSTOMER and CORPORATE_CUSTOMER)." vertex="1">
          <mxGeometry height="88" width="310" x="305" y="493" as="geometry" />
        </mxCell>
