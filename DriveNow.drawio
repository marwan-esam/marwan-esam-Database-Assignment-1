          <mxGeometry height="52" width="240" x="120" y="1235" as="geometry" />
        </mxCell>
        <mxCell id="pcd_1_c64" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="Since a blacklisted customer &amp;quot;cannot book again,&amp;quot; blacklisting is modeled as a 1:N relationship Blacklists from Employee to Customer with Date and Reason attributes (stored as nullable columns on CUSTOMER)." vertex="1">
          <mxGeometry height="52" width="820" x="360" y="1235" as="geometry" />
        </mxCell>
        <mxCell id="pcd_1_c65" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f8f4;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=center;spacingLeft=0;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;A8&lt;/b&gt;" vertex="1">
          <mxGeometry height="52" width="60" x="60" y="1287" as="geometry" />
        </mxCell>
        <mxCell id="pcd_1_c66" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f8f4;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;7.10 Loyalty Program&lt;/b&gt;" vertex="1">
          <mxGeometry height="52" width="240" x="120" y="1287" as="geometry" />
        </mxCell>
        <mxCell id="pcd_1_c67" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f8f4;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="TotalPoints and LoyaltyTier on IndividualCustomer are modeled as derived attributes calculated from the sum of Points in LoyaltyTransaction so that tiers are never manually typed out of sync." vertex="1">
          <mxGeometry height="52" width="820" x="360" y="1287" as="geometry" />
        </mxCell>
        <mxCell id="pcd_1_c68" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=center;spacingLeft=0;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;A9&lt;/b&gt;" vertex="1">
          <mxGeometry height="52" width="60" x="60" y="1339" as="geometry" />
        </mxCell>
        <mxCell id="pcd_1_c69" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;7.11 Reservations &amp;amp; 7.12 Rentals&lt;/b&gt;" vertex="1">
          <mxGeometry height="52" width="240" x="120" y="1339" as="geometry" />
        </mxCell>
        <mxCell id="pcd_1_c70" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="For each AdditionalDriver added to a Rental, we store DriverNo (partial key), Name, Phone, LicenseDetails (LicenseNo, LicenseExpiryDate), and DailyFee, and Reservation includes BookingChannel (Phone, Branch, Website)." vertex="1">
          <mxGeometry height="52" width="820" x="360" y="1339" as="geometry" />
        </mxCell>
        <mxCell id="pcd_1_c71" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f8f4;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=center;spacingLeft=0;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;A10&lt;/b&gt;" vertex="1">
          <mxGeometry height="70" width="60" x="60" y="1391" as="geometry" />
        </mxCell>
        <mxCell id="pcd_1_c72" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f8f4;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;7.4 Extras &amp;amp; 7.13 Insurance&lt;/b&gt;" vertex="1">
          <mxGeometry height="70" width="240" x="120" y="1391" as="geometry" />
        </mxCell>
        <mxCell id="pcd_1_c73" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f8f4;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="Historical prices charged for Extras (ChargedRate) and Insurance Packages (PriceCharged) are captured directly on the Includes_Extra and Includes_Insurance relationships per rental, while Extra and InsurancePackage store the current catalog price (CurrentDailyCharge, CurrentDailyPrice)." vertex="1">
          <mxGeometry height="70" width="820" x="360" y="1391" as="geometry" />
        </mxCell>
        <mxCell id="pcd_1_c74" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=center;spacingLeft=0;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;A11&lt;/b&gt;" vertex="1">
          <mxGeometry height="52" width="60" x="60" y="1461" as="geometry" />
        </mxCell>
        <mxCell id="pcd_1_c75" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;7.14 Feedback&lt;/b&gt;" vertex="1">
          <mxGeometry height="52" width="240" x="120" y="1461" as="geometry" />
        </mxCell>
        <mxCell id="pcd_1_c76" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="Since a customer can submit at most one feedback per rental, Feedback is modeled as a 1:1 weak entity identified by Rental." vertex="1">
          <mxGeometry height="52" width="820" x="360" y="1461" as="geometry" />
        </mxCell>
        <mxCell id="pcd_1_c77" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f8f4;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=center;spacingLeft=0;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;A12&lt;/b&gt;" vertex="1">
          <mxGeometry height="52" width="60" x="60" y="1513" as="geometry" />
        </mxCell>
        <mxCell id="pcd_1_c78" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f8f4;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;7.15 Maintenance and Parts&lt;/b&gt;" vertex="1">
          <mxGeometry height="52" width="240" x="120" y="1513" as="geometry" />
        </mxCell>
        <mxCell id="pcd_1_c79" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f8f4;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="Surrogate primary keys ID are used for Supplier (SupplierID) and Part (PartID / PartNo), while Supplier.Name, Supplier.Phone, and Supplier.Email are enforced as UNIQUE." vertex="1">
          <mxGeometry height="52" width="820" x="360" y="1513" as="geometry" />
        </mxCell>
        <mxCell id="pcd_1_c80" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontColor=#1a1a1a;" value="&lt;b&gt;3. Contradictions (with Both SRS Sections)&lt;/b&gt;" vertex="1">
          <mxGeometry height="28" width="700" x="60" y="1615" as="geometry" />
        </mxCell>
        <mxCell id="pcd_1_c81" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7a2e2e;strokeColor=#0f2c47;fontColor=#ffffff;fontSize=12;verticalAlign=middle;align=center;spacingLeft=0;spacingRight=6;" value="&lt;b&gt;#&lt;/b&gt;" vertex="1">
          <mxGeometry height="38" width="60" x="60" y="1649" as="geometry" />
        </mxCell>
        <mxCell id="pcd_1_c82" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7a2e2e;strokeColor=#0f2c47;fontColor=#ffffff;fontSize=12;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;Sections that Disagree&lt;/b&gt;" vertex="1">
          <mxGeometry height="38" width="280" x="120" y="1649" as="geometry" />
        </mxCell>
        <mxCell id="pcd_1_c83" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7a2e2e;strokeColor=#0f2c47;fontColor=#ffffff;fontSize=12;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=6;" value="&lt;b&gt;Description of Contradiction&lt;/b&gt;" vertex="1">
          <mxGeometry height="38" width="780" x="400" y="1649" as="geometry" />
        </mxCell>
        <mxCell id="pcd_1_c84" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=center;spacingLeft=0;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;C1&lt;/b&gt;" vertex="1">
          <mxGeometry height="70" width="60" x="60" y="1687" as="geometry" />
        </mxCell>
        <mxCell id="pcd_1_c85" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;Section 7.3 (Paragraph 1 &amp;amp; 3) vs. Section 7.3 (COO Note)&lt;/b&gt;" vertex="1">
          <mxGeometry height="70" width="280" x="120" y="1687" as="geometry" />
        </mxCell>
        <mxCell id="pcd_1_c86" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="Paragraph 1 &amp;amp; 3 state: &amp;quot;Customers do not book a specific car. They book a category&amp;quot; and &amp;quot;Pricing is set per category as a daily rate.&amp;quot; However, the COO&amp;#x27;s Note in the same section states: &amp;quot;Some of our luxury cars, like the Mercedes S-Class we got last year, don&amp;#x27;t follow the category price. They have their own price.&amp;quot;" vertex="1">
          <mxGeometry height="70" width="780" x="400" y="1687" as="geometry" />
        </mxCell>
        <mxCell id="pcd_1_c87" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf4f4;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=center;spacingLeft=0;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;C2&lt;/b&gt;" vertex="1">
          <mxGeometry height="70" width="60" x="60" y="1757" as="geometry" />
        </mxCell>
        <mxCell id="pcd_1_c88" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf4f4;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&lt;b&gt;Section 7.16 (Paragraph 1) vs. Section 7.16 (Finance Note) &amp;amp; Section 4&lt;/b&gt;" vertex="1">
          <mxGeometry height="70" width="280" x="120" y="1757" as="geometry" />
        </mxCell>
        <mxCell id="pcd_1_c89" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf4f4;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="Section 7.16 Paragraph 1 models payments strictly per rental (&amp;quot;A rental may have several payments: a deposit at pickup, the final payment at return...&amp;quot;). However, the Finance Note states: &amp;quot;Our corporate clients usually don&amp;#x27;t pay per rental. We send them one invoice at the end of every month.&amp;quot;" vertex="1">
          <mxGeometry height="70" width="780" x="400" y="1757" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_14_4_Business_Rules" name="4-Business-Rules">
    <mxGraphModel dx="658" dy="1010" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="2400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
