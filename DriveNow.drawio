        <mxCell id="pcd_2_c36" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f4f9;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="&amp;quot;Individual customers drive the car themselves. For corporate rentals, the contract must name which of the company&amp;#x27;s authorized drivers is the main driver.&amp;quot;" vertex="1">
          <mxGeometry height="124" width="310" x="305" y="687" as="geometry" />
