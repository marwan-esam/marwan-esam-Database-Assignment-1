        <mxCell id="pcd_2_c31" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0bec5;fontColor=#1a1a1a;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" value="A reservation can only apply a PromoCode if the reservation date falls within the promo code&amp;#x27;s validity period (StartDate to EndDate) AND the number of existing reservations using that code is less than MaxUses." vertex="1">
          <mxGeometry height="106" width="310" x="305" y="581" as="geometry" />
        </mxCell>
